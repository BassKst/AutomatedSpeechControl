version: "3.9"

services:

  remnanode:

    image: remnawave/node:latest

    container_name: "{{ node_name }}"

    hostname: "{{ node_name }}"

    restart: always

    network_mode: host

    cap_add:
      - NET_ADMIN

    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576

    env_file:
      - .env

    volumes:
      - ./data:/var/lib/remnanode

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"